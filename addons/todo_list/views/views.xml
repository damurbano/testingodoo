<odoo>
  <data>

    <!-- ===================== TAREAS ===================== -->

    <!-- Vista de lista de tareas -->
    <record model="ir.ui.view" id="task_list">
      <field name="name">task.list</field>
      <field name="model">todo_list.task</field>
      <field name="arch" type="xml">
        <tree decoration-danger="is_late" decoration-muted="state == 'cancelled'" decoration-success="state == 'done'">
          <field name="name"/>
          <field name="user_id"/>
          <field name="priority"/>
          <field name="state"/>
          <field name="date_deadline"/>
          <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
          <field name="is_late" invisible="1"/>
        </tree>
      </field>
    </record>

    <!-- Vista Kanban de tareas -->
    <record model="ir.ui.view" id="task_kanban">
      <field name="name">task.kanban</field>
      <field name="model">todo_list.task</field>
      <field name="arch" type="xml">
        <kanban default_group_by="stage_id" class="o_kanban_small_column">
          <field name="name"/>
          <field name="stage_id"/>
          <field name="state"/>
          <field name="priority"/>
          <field name="date_deadline"/>
          <field name="user_id"/>
          <field name="tag_ids"/>
          <field name="is_late"/>
          <field name="color"/>
          <templates>
            <t t-name="kanban-box">
              <div t-attf-class="oe_kanban_global_click o_kanban_record #{record.is_late.raw_value ? 'bg-danger-subtle' : ''}">
                <div class="oe_kanban_content">
                  <div class="o_kanban_record_top">
                    <div class="o_kanban_record_headings">
                      <strong class="o_kanban_record_title">
                        <field name="name"/>
                      </strong>
                    </div>
                  </div>
                  <div class="o_kanban_record_body">
                    <div>
                      <span class="badge bg-danger" t-if="record.priority.raw_value == '3'">Urgente</span>
                      <span class="badge bg-warning" t-if="record.priority.raw_value == '2'">Alta</span>
                    </div>
                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                  </div>
                  <div class="o_kanban_record_bottom">
                    <div class="oe_kanban_bottom_left">
                      <span t-if="record.date_deadline.raw_value" t-attf-class="#{record.is_late.raw_value ? 'text-danger fw-bold' : ''}">
                        <i class="fa fa-clock-o"/> <field name="date_deadline"/>
                      </span>
                    </div>
                    <div class="oe_kanban_bottom_right">
                      <field name="user_id" widget="many2one_avatar_user"/>
                    </div>
                  </div>
                </div>
              </div>
            </t>
          </templates>
        </kanban>
      </field>
    </record>

    <!-- Vista de formulario de tareas -->
    <record model="ir.ui.view" id="task_form">
      <field name="name">task.form</field>
      <field name="model">todo_list.task</field>
      <field name="arch" type="xml">
        <form>
          <header>
            <button name="action_start" string="Iniciar" type="object" class="btn-primary" invisible="state != 'todo'"/>
            <button name="action_done" string="Completar" type="object" class="btn-success" invisible="state not in ('todo', 'in_progress')"/>
            <button name="action_cancel" string="Cancelar" type="object" invisible="state not in ('todo', 'in_progress')"/>
            <button name="action_restart" string="Reabrir" type="object" invisible="state not in ('done', 'cancelled')"/>
            <field name="state" widget="statusbar" statusbar_visible="todo,in_progress,done"/>
          </header>
          <sheet>
            <div class="oe_title">
              <h1>
                <field name="name" placeholder="Nombre de la tarea..."/>
              </h1>
            </div>
            <group>
              <group>
                <field name="stage_id"/>
                <field name="user_id"/>
                <field name="priority" widget="priority"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
              </group>
              <group>
                <field name="date_deadline"/>
                <field name="date_done" invisible="state != 'done'"/>
                <field name="is_late" invisible="1"/>
              </group>
            </group>
            <notebook>
              <page string="Descripción">
                <field name="description" placeholder="Describe la tarea..."/>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>

    <!-- Acción de tareas -->
    <record model="ir.actions.act_window" id="action_tasks">
      <field name="name">Mis Tareas</field>
      <field name="res_model">todo_list.task</field>
      <field name="view_mode">kanban,tree,form</field>
    </record>

    <!-- ===================== ETIQUETAS ===================== -->

    <!-- Vista de lista de etiquetas -->
    <record model="ir.ui.view" id="tag_list">
      <field name="name">tag.list</field>
      <field name="model">todo_list.tag</field>
      <field name="arch" type="xml">
        <tree editable="bottom">
          <field name="name"/>
          <field name="color" widget="color_picker"/>
        </tree>
      </field>
    </record>

    <!-- Acción de etiquetas -->
    <record model="ir.actions.act_window" id="action_tags">
      <field name="name">Etiquetas</field>
      <field name="res_model">todo_list.tag</field>
      <field name="view_mode">tree</field>
    </record>

    <!-- ===================== MENÚS ===================== -->

    <!-- Menú principal -->
    <menuitem name="To-Do" id="menu_root" web_icon="todo_list,static/description/icon.png"/>
    
    <!-- Submenús -->
    <menuitem name="Tareas" id="menu_tasks" parent="menu_root" action="action_tasks" sequence="10"/>
    <menuitem name="Configuración" id="menu_config" parent="menu_root" sequence="100"/>
    <menuitem name="Etiquetas" id="menu_tags" parent="menu_config" action="action_tags"/>

  </data>
</odoo>

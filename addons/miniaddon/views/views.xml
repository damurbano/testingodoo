<odoo>
  <data>
    <!-- explicit list view definition -->

    <record model="ir.ui.view" id="miniaddon.list">
      <field name="name">miniaddon list</field>
      <field name="model">miniaddon.miniaddon</field>
      <field name="arch" type="xml">
        <tree>
          <field name="name"/>
          <field name="value"/>
          <field name="value2"/>
        </tree>
      </field>
    </record>


    <!-- actions opening views on models -->

    <record model="ir.actions.act_window" id="miniaddon.action_window">
      <field name="name">miniaddon window</field>
      <field name="res_model">miniaddon.miniaddon</field>
      <field name="view_mode">tree,form</field>
    </record>


    <!-- server action to the one above -->

    <record model="ir.actions.server" id="miniaddon.action_server">
      <field name="name">miniaddon server</field>
      <field name="model_id" ref="model_miniaddon_miniaddon"/>
      <field name="state">code</field>
      <field name="code">
        action = {
          "type": "ir.actions.act_window",
          "view_mode": "tree,form",
          "res_model": model._name,
        }
      </field>
    </record>


    <!-- Top menu item -->
    <menuitem name="miniaddon" id="miniaddon.menu_root"/>
    <!-- menu categories -->
    <menuitem name="Menu 1" id="miniaddon.menu_1" parent="miniaddon.menu_root"/>
    <menuitem name="Menu 2" id="miniaddon.menu_2" parent="miniaddon.menu_root"/> 

    <!-- actions -->
    <menuitem name="List" id="miniaddon.menu_1_list" parent="miniaddon.menu_1"
              action="miniaddon.action_window"/>
    <menuitem name="Server to list" id="miniaddon" parent="miniaddon.menu_2"
              action="miniaddon.action_server"/>

  </data>
</odoo>
